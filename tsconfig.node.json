{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    // electron-vite/node 가 있어야 `?modulePath` 모듈 선언과
    // NodeJS.ProcessEnv.ELECTRON_RENDERER_URL 타입이 잡힌다. 없으면 TS2307 로 빌드가 막힌다.
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/mcp/**/*.ts",
    "src/hooks/**/*.ts",
    "src/child/**/*.ts",
    "src/shared/**/*.ts",
    "electron.vite.config.ts"
  ]
}
